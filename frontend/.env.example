# OPTIONAL. The desktop app (frontend\app.py) already uses backend\.env, so with that file in place
# you need nothing here. Make frontend\.env only if the app should use a DIFFERENT Neon database
# (or you keep no backend\.env):
#   PowerShell:      Copy-Item frontend\.env.example frontend\.env
#   macOS / Linux:   cp frontend/.env.example frontend/.env
#
# DATABASE_URL: your Neon connection string. In the Neon console, open your project, click Connect,
# and copy the string (pooled, with "-pooler" in the host, or direct: both work). Keep
# ?sslmode=require at the end. No quotes and no spaces around "=".
#
# Which one the app uses: a DATABASE_URL set in the terminal, else this folder's .env, else backend\.env.
# The ingest window and the backend scripts never read this file: they use backend\.env.
# Never commit .env: it holds your database password (.gitignore keeps it out; only this example is shared).

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
